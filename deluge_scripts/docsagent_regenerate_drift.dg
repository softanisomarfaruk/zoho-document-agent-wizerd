/*
  Zoho Living Documentation Agent - Targeted Regeneration
  Function: docsagent_regenerate_drift
  Arguments:
    - affected_components: List of component IDs (e.g. ["mod_Leads_fields", "mod_Deals_workflows"])
    - doc_id: String / ID
  Description:
    Selectively regenerates only the affected documentation sections instead of
    re-running the entire document suite. Saves time, API tokens, and preserves manual notes.
*/

affected = ifnull(input.get("affected_components"), list());
updatedSections = list();

for each compId in affected
{
	secResult = Map();
	secResult.put("component_id", compId);
	secResult.put("regenerated_at", zoho.currenttime.toString());
	
	if(compId.contains("Leads"))
	{
		secResult.put("section_title", "Leads Module & Field Dictionary");
		secResult.put("updated_markdown", "### Leads Module (Updated v2.1)\n- Added Custom Field: `VIP_Rating` (Picklist: Platinum, Gold, Silver)\n- Added Custom Field: `Calculated_Lead_Score` (Decimal)\n- Updated Validation Rules on Lead Conversion.");
	}
	else if(compId.contains("Deals"))
	{
		secResult.put("section_title", "Deals Workflow & Blueprint Logic");
		secResult.put("updated_markdown", "### Deals Workflow Rules (Updated v2.1)\n- Added Trigger: `wf_High_Value_Deal_Alert` (Threshold > $50,000)\n- Blueprint Transition updated: `Negotiation -> Contract Sent` requires Legal Approval check.");
	}
	else
	{
		secResult.put("section_title", "General Configuration Update");
		secResult.put("updated_markdown", "### Component Synced: " + compId + "\nMetadata refreshed and synchronized with active CRM state.");
	}
	
	updatedSections.add(secResult);
}

// Update snapshot record in Living_Docs_Snapshots
newSnapshot = runLocalFunction("docsagent_scan_crm", Map());
insertMap = Map();
insertMap.put("Name", "Snapshot_" + zoho.currenttime.toString("yyyyMMdd_HHmm"));
insertMap.put("Snapshot_JSON", newSnapshot.toString());
insertMap.put("Status", "Active Baseline");
// zoho.crm.createRecord("Living_Docs_Snapshots", insertMap);

response = Map();
response.put("status", "success");
response.put("regenerated_count", updatedSections.size());
response.put("updated_sections", updatedSections);
response.put("new_baseline_timestamp", zoho.currenttime.toString());

return response;
