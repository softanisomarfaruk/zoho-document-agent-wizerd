/*
  Zoho Living Documentation Agent - Metadata Scanner
  Function: docsagent_scan_crm
  Arguments: None (or optional map {"modules": ["Leads", "Deals"]})
  Description:
    Pulls configuration metadata (modules, fields, picklists, workflows, blueprints,
    custom functions, webhooks) into a normalized JSON snapshot and computes component hashes.
*/

scanResult = Map();
scanResult.put("timestamp", zoho.currenttime.toString("yyyy-MM-dd'T'HH:mm:ssXXX"));
scanResult.put("org_id", zoho.crm.getOrgInfo().get("org").get("id"));

// List of target modules to scan (defaults to standard CRM core modules + custom modules)
targetModules = list();
if(input.containsKey("modules") && input.get("modules") != null)
{
	targetModules = input.get("modules");
}
else
{
	targetModules = {"Leads", "Contacts", "Accounts", "Deals", "Products", "Quotes"};
}

modulesList = list();
totalFields = 0;
totalWorkflows = 0;
totalBlueprints = 0;
totalFunctions = 0;

for each mod in targetModules
{
	modData = Map();
	modData.put("module", mod);
	modData.put("component_id", "mod_" + mod);
	
	// 1. Fetch Fields metadata
	fieldList = list();
	fieldsResp = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v6/settings/fields?module=" + mod
		type :GET
		connection:"zoho_crm_conn"
	];
	
	if(fieldsResp != null && fieldsResp.containsKey("fields"))
	{
		for each f in fieldsResp.get("fields")
		{
			fMap = Map();
			fMap.put("id", f.get("id"));
			fMap.put("api_name", f.get("api_name"));
			fMap.put("label", f.get("field_label"));
			fMap.put("data_type", f.get("data_type"));
			fMap.put("required", ifnull(f.get("system_mandatory"), false));
			fMap.put("custom_field", ifnull(f.get("custom_field"), false));
			
			// Extract picklist values if present
			if(f.containsKey("pick_list_values") && f.get("pick_list_values") != null)
			{
				pvList = list();
				for each pv in f.get("pick_list_values")
				{
					pvList.add(pv.get("display_value"));
				}
				fMap.put("pick_list_values", pvList);
			}
			
			// Simple content hash representation
			fContent = mod + ":" + f.get("api_name") + ":" + f.get("data_type") + ":" + f.get("field_label");
			fMap.put("hash", md5(fContent));
			fieldList.add(fMap);
			totalFields = totalFields + 1;
		}
	}
	modData.put("fields", fieldList);
	
	// 2. Fetch Workflow Automation rules (Zoho CRM API v8)
	wfList = list();
	wfResp = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v8/settings/automation/workflow_rules?module=" + mod
		type :GET
		connection:"docsagent_connection"
	];
	
	if(wfResp != null && wfResp.containsKey("workflow_rules"))
	{
		for each w in wfResp.get("workflow_rules")
		{
			wMap = Map();
			wMap.put("id", w.get("id"));
			wMap.put("name", w.get("name"));
			
			// API v8 status can be map or string
			wStatus = "active";
			if(w.containsKey("status") && w.get("status") != null)
			{
				if(w.get("status").toString().contains("active"))
				{
					wStatus = "active";
				}
				else
				{
					wStatus = "inactive";
				}
			}
			wMap.put("status", wStatus);
			
			// API v8 execute_when
			trigType = "on_record_action";
			if(w.containsKey("execute_when") && w.get("execute_when") != null && w.get("execute_when").containsKey("type"))
			{
				trigType = w.get("execute_when").get("type");
			}
			wMap.put("trigger_type", trigType);
			wMap.put("criteria", ifnull(w.get("criteria"), ""));
			
			actionsList = list();
			if(w.containsKey("actions") && w.get("actions") != null)
			{
				for each act in w.get("actions")
				{
					actionsList.add(act.get("type") + ": " + ifnull(act.get("name"), ""));
				}
			}
			wMap.put("actions", actionsList);
			
			wfContent = mod + ":" + w.get("name") + ":" + wStatus + ":" + ifnull(w.get("criteria"), "");
			wMap.put("hash", md5(wfContent));
			wfList.add(wMap);
			totalWorkflows = totalWorkflows + 1;
		}
	}
	modData.put("workflows", wfList);
	
	// 3. Fetch Blueprints
	bpList = list();
	bpResp = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v6/settings/blueprints?module=" + mod
		type :GET
		connection:"zoho_crm_conn"
	];
	
	if(bpResp != null && bpResp.containsKey("blueprints"))
	{
		for each b in bpResp.get("blueprints")
		{
			bMap = Map();
			bMap.put("id", b.get("id"));
			bMap.put("name", b.get("name"));
			bMap.put("field_name", ifnull(b.get("field_name"), "Stage"));
			
			transList = list();
			if(b.containsKey("transitions") && b.get("transitions") != null)
			{
				for each t in b.get("transitions")
				{
					tMap = Map();
					tMap.put("transition_id", t.get("id"));
					tMap.put("name", t.get("name"));
					tMap.put("from_state", t.get("from_state"));
					tMap.put("to_state", t.get("to_state"));
					transList.add(tMap);
				}
			}
			bMap.put("transitions", transList);
			bContent = mod + ":" + b.get("name") + ":" + transList.toString();
			bMap.put("hash", md5(bContent));
			bpList.add(bMap);
			totalBlueprints = totalBlueprints + 1;
		}
	}
	modData.put("blueprints", bpList);
	
	// Compute Module Aggregated Hash
	modData.put("hash", md5(mod + ":" + fieldList.size() + ":" + wfList.size() + ":" + bpList.size()));
	modulesList.add(modData);
}

scanResult.put("modules", modulesList);

// 4. Fetch Custom Functions and Webhooks
funcList = list();
funcResp = invokeurl
[
	url :"https://www.zohoapis.com/crm/v6/settings/functions"
	type :GET
	connection:"zoho_crm_conn"
];

if(funcResp != null && funcResp.containsKey("functions"))
{
	for each fn in funcResp.get("functions")
	{
		fnMap = Map();
		fnMap.put("id", fn.get("id"));
		fnMap.put("name", fn.get("display_name"));
		fnMap.put("api_name", fn.get("api_name"));
		fnMap.put("return_type", ifnull(fn.get("return_type"), "void"));
		fnMap.put("description", ifnull(fn.get("description"), ""));
		fnContent = fn.get("api_name") + ":" + ifnull(fn.get("description"), "");
		fnMap.put("hash", md5(fnContent));
		funcList.add(fnMap);
		totalFunctions = totalFunctions + 1;
	}
}
scanResult.put("functions", funcList);

// Summary Stats
stats = Map();
stats.put("total_modules", modulesList.size());
stats.put("total_fields", totalFields);
stats.put("total_workflows", totalWorkflows);
stats.put("total_blueprints", totalBlueprints);
stats.put("total_functions", totalFunctions);
scanResult.put("stats", stats);

// Save snapshot to custom module / cache if configured
return scanResult;
